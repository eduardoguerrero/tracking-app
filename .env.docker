APP_NAME=Aeroflash
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aeroflash
DB_USERNAME=aeroflash
DB_PASSWORD=aeroflash_secret

JWT_SECRET=docker-jwt-secret-key-minimum-32-chars-long!!
JWT_TTL=3600
JWT_REFRESH_TTL=1209600

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
