APP_NAME=Aeroflash
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

# JWT_SECRET is injected via docker-compose or .env at project root
JWT_TTL=3600
JWT_REFRESH_TTL=1209600

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
